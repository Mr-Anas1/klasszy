rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // Helper to check if user belongs to the same school as the resource
    function belongsToSchool(schoolId) {
      return request.auth != null && getUserData().schoolId == schoolId;
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || getUserData().schoolId == resource.data.schoolId);
      allow write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Students, Classes, Announcements, Homework, Attendance
    match /{collection}/{docId} {
      allow read, write: if belongsToSchool(resource.data.schoolId) || belongsToSchool(request.resource.data.schoolId);
      
      // Special case for creating new docs
      allow create: if request.auth != null && belongsToSchool(request.resource.data.schoolId);
    }

    // Remark Replies collection
    match /remarkReplies/{replyId} {
      allow read: if belongsToSchool(resource.data.schoolId);
      allow create: if request.auth != null && belongsToSchool(request.resource.data.schoolId);
      allow update, delete: if false; // Replies are immutable
    }

    // Leave Applications collection
    match /leaveApplications/{leaveId} {
      allow read: if belongsToSchool(resource.data.schoolId);
      allow create: if request.auth != null && belongsToSchool(request.resource.data.schoolId);
      
      // Teachers can update pending_teacher status
      allow update: if request.auth != null 
        && belongsToSchool(resource.data.schoolId)
        && getUserData().role == 'teacher'
        && resource.data.status == 'pending_teacher';
      
      // Admins can update pending_admin status
      allow update: if request.auth != null 
        && belongsToSchool(resource.data.schoolId)
        && getUserData().role == 'admin'
        && resource.data.status == 'pending_admin';
    }
  }
}
